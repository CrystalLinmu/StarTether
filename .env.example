# ──────────────────────────────────
# RAG Nexus · 环境配置
# 复制此文件为 .env 并填入真实密钥
# ──────────────────────────────────

# ── 数据库 ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_db

# ── DashScope（阿里云 · Embedding + Rerank） ──
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

# ── DeepSeek（对话 / 评级 / 重写 / 实体提取） ──
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat

# ── Rerank ──
DASHSCOPE_RERANK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_RERANK_MODEL=qwen3-rerank
DASHSCOPE_RERANK_URL=https://dashscope-intl.aliyuncs.com/compatible-api/v1/reranks
DASHSCOPE_RERANK_INSTRUCT=根据用户问题，从候选文档片段中找出最能回答问题的相关内容。

# ── Milvus 向量库 ──
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=rag_chunks_hybrid
MILVUS_TEXT_MAX_LENGTH=4096

# ── 分块参数 ──
L1_CHUNK_MAX_CHARS=2400
L2_CHUNK_MAX_CHARS=1600
L3_CHUNK_MAX_CHARS=500
L3_CHUNK_OVERLAP_CHARS=60
SEMANTIC_MERGE_SIMILARITY=0.62
AUTO_MERGE_MIN_CHILDREN=2
AUTO_MERGE_CHILD_RATIO=0.6
AUTO_MERGE_MAX_PARENT_CHARS=1800
MAX_CHUNKS_PER_DOC=500

# ── 检索参数 ──
TOP_K=5
CANDIDATE_TOP_K=12
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MIN_CONTEXTS=2
QUERY_REWRITE_MIN_BEST_SCORE=0.015
HISTORY_MESSAGE_LIMIT=20
SUMMARY_TRIGGER_MESSAGES=40
SUMMARY_KEEP_RECENT_MESSAGES=10

# ── GraphRAG 知识图谱 ──
GRAPH_RETRIEVAL_ENABLED=true
GRAPH_MAX_HOPS=2
GRAPH_TOP_K_ENTITIES=10
GRAPH_TOP_K_CHUNKS=5
ENTITY_EXTRACTION_BATCH_SIZE=8
ENTITY_EXTRACTION_CONFIDENCE_THRESHOLD=0.6
ENTITY_SIMILARITY_THRESHOLD=0.82
GRAPH_COMMUNITY_MIN_SIZE=3
COMMUNITY_LEVELS=3

# ── Neo4j（可视化用，可选，不开启不影响检索） ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ── LangSmith 追踪（可选） ──
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=enterprise-rag-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
